{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".expo/**"],
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_ANON_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@safebus/web#test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["VITEST_MAX_FORKS", "VITEST_MIN_FORKS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/migrations/**/*.sql",
        "$TURBO_ROOT$/config/pending/*.json",
        "$TURBO_ROOT$/supabase/functions/_shared/**/*.mjs",
        "$TURBO_ROOT$/scripts/lib/authority-directory.mjs",
        "$TURBO_ROOT$/config/authority-directory-search-aliases.json",
        "$TURBO_ROOT$/tests/fixtures/authority-directory/**",
        "$TURBO_ROOT$/docs/qa/authority-directory-hosted-schema-2026-10-25.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}

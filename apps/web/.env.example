# Supabase (web app - Vite exposes VITE_ prefixed vars)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Override the site origin used in password-reset/invitation redirect URLs.
# VITE_APP_ORIGIN=http://localhost:5173

# Optional: Map tiles for routes map + fleet map.
# Without these, maps show a coordinate fallback list instead of an interactive map.
# For local dev, public OpenStreetMap tiles work. For production, use your own provider.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# ─── Netlify Functions (server-side only — NEVER prefix with VITE_) ───────────
# Required for local dev with `pnpm dev` (or `pnpm dev:netlify`) and for production.
# Create a .env file with these values. Do NOT commit real secrets.
# SUPABASE_URL=             (same as VITE_SUPABASE_URL)
# SUPABASE_ANON_KEY=        (same as VITE_SUPABASE_ANON_KEY)
# SUPABASE_SECRET_KEY=      (service role key — server only, never in browser)
# SAFEBUS_INVITE_REDIRECT_URL=http://localhost:5173/accept-invitation

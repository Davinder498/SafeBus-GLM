# Root developer tooling only. Do not commit real values.

# No hosted non-production database is currently approved. Do not configure
# SAFEBUS_RLS_TEST_DATABASE_URL or SAFEBUS_QA_SEED_DATABASE_URL with the sole
# production database. The guarded tools remain unavailable until the Platform
# Administrator explicitly approves a separate test database or branch.

# Server-only Netlify Function values. Never prefix these with VITE_ or expose
# their values to browser code. Use verified deployment secrets in Netlify.
SAFEBUS_EMAIL_PROVIDER_API_KEY=
SAFEBUS_EMAIL_FROM=
SAFEBUS_EMAIL_FROM_NAME=BusSafe Alberta
SAFEBUS_INQUIRY_TO=
